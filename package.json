{
  "name": "gus",
  "version": "0.1.0",
  "description": "AI-assisted repository workflow automation tool",
  "type": "module",
  "bin": {
    "gus": "./dist/cli/main.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "keywords": ["git", "commit", "ai", "cli", "automation", "workflow"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Muhammad-Jay/gus.git"
  },
  "homepage": "https://github.com/Muhammad-Jay/gus#readme",
  "bugs": {
    "url": "https://github.com/Muhammad-Jay/gus/issues"
  },
  "scripts": {
    "dev": "tsx src/cli/main.ts",
    "build": "tsup",
    "start": "node dist/cli/main.js",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "ai": "^4.0.0",
    "@ai-sdk/openai": "^1.0.0",
    "commander": "^12.0.0",
    "@clack/prompts": "^0.7.0",
    "execa": "^9.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "tsup": "^8.3.0",
    "vitest": "^2.1.0",
    "@biomejs/biome": "^1.9.0"
  }
}
